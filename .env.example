# ---- Telegram bot credentials ----
# Get this from @BotFather on Telegram
BOT_TOKEN=123456789:AAbecomeYourRealTokenHere

# ---- Required for the LOCAL Bot API server (2GB uploads) ----
# Get these from https://my.telegram.org -> API Development Tools
# (log in with your own phone number, this is free, one-time)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef1234567890abcdef1234567890

# ---- Developers/maintainers ----
# Comma-separated Telegram numeric user IDs that get /update, /potcheck,
# and can also open the owner's admin panel for maintenance.
# Get IDs from @userinfobot.
ADMIN_USER_IDS=111111111,222222222

# ---- The owner (the person this bot is for) ----
# Her Telegram numeric user ID - she gets the admin panel and always
# bypasses access-control/force-join, regardless of what she sets there.
OWNER_USER_ID=333333333

# English letters only. Used for her admin panel command:
# "Candy" -> /candy_admin, "Amy Rose" -> /amy_rose_admin
OWNER_NAME=Candy

# Shows up throughout the bot's messages and progress bar
OWNER_EMOJI=🍬

# ---- Behavior ----
# Hour (UTC, 0-23) the daily yt-dlp/gallery-dl auto-update check runs
AUTO_UPDATE_HOUR_UTC=4

# Max number of downloads processed in parallel across all users
MAX_CONCURRENT_DOWNLOADS=2

# ---- Site routing (WARP) ----
# Many sites (YouTube, X, Instagram...) block VPS addresses. In "auto" mode the bot goes direct and only uses the
# bundled WARP proxy for a site when THAT site refuses the server's address (each site is tracked separately). "always" uses it all the time, "off" never.
# YT_PROXY_MODE=auto
# Comma-separated proxies (only the sites in PROXY_DOMAINS use them). Default is the warp container in docker-compose.yml.
# YT_PROXIES=socks5h://warp:1080
# Which sites may be routed (subdomains included). * = every site. yt-dlp and gallery-dl only: aria2c can't use SOCKS.
# PROXY_DOMAINS=youtube.com,youtu.be,x.com,twitter.com,instagram.com,pinterest.com,pin.it,reddit.com,tiktok.com

# ---- Resource limits (so ffmpeg can't take over a home PC) ----
# BOT_CPUS=2
# BOT_MEM_LIMIT=3g
# PROCESS_NICE=10

# ---- Burned-in subtitles / toolbox ----
# Burning subtitles re-encodes the whole video. Videos longer than this (seconds) get a separate .srt instead.
# 0 = no limit.
# BURN_MAX_SECONDS=3600

# ---- Housekeeping ----
# Every few minutes the bot kills leftover ffmpeg/aria2c/gallery-dl processes of finished or cancelled jobs, collects
# zombies, and deletes the local Bot API server's copies of files people sent (older than this many minutes).
# BOT_API_CLEANUP=on
# BOT_API_FILE_MAX_AGE_MINUTES=60
# HOUSEKEEPING_INTERVAL_SECONDS=300

# ---- Change the WARP address from the admin panel (optional) ----
# 1. put a long random string in WARP_CONTROL_TOKEN and set the URL below,
# 2. start the control service:  docker compose --profile warp-control up -d
# Then: admin panel > WARP > Change address. Leave the token empty to keep the button off.
# WARP_CONTROL_URL=http://warp-control:8765
# WARP_CONTROL_TOKEN=
# WARP_ROTATE_COOLDOWN_SECONDS=120


# ---------------------------------------------------------------------------------------------------------------
# Web app (rev9/rev10). Same engine as the bot, in a browser, plus expiring download links ("Get a link", in the web
# app AND in the bot: the files are kept on THIS server and served by the web app). Off by default.
#   1. WEB_ENABLED=on, and give the first admin below (it is only created when no admin exists yet).
#   2. Pick where you run it:
#      LOCAL (debugging on your own computer, plain http, only you can reach it): uncomment the 6 lines of the
#           "LOCAL" block below, then   docker compose up --build   and open http://localhost:8080
#           (or with no Docker/Telegram at all:  cd bot && python web_dev.py)
#      VPS (HTTPS), choose one:
#        a) a domain pointing at the VPS:  WEB_DOMAIN + WEB_PUBLIC_URL below, then
#           docker compose up -d --build && docker compose --profile web up -d   (Caddy gets the certificate itself)
#        b) no domain / no open ports: run a Cloudflare Tunnel to  http://bot:8080  and set WEB_PUBLIC_URL to its address.
#   3. Open the address, sign in, choose your own password (you are asked to).
#   More accounts: Admin tab in the web app, or in the bot:  /webaccount add <name> [telegram_id] [admin]
#   Anyone the bot lets in can get their own login by sending the bot  /weblogin
#   Download links: WEB_PUBLIC_URL is what goes into the links the bot sends, so set it to the address people really
#   open (https://downloads.example.com on the VPS). Length, allowance and on/off: Admin tab > Download links.
# ---------------------------------------------------------------------------------------------------------------
# WEB_ENABLED=on
# WEB_DOMAIN=downloads.example.com
# WEB_PUBLIC_URL=https://downloads.example.com
# WEB_ADMIN_USER=owner
# WEB_ADMIN_PASSWORD=pick-a-long-one-then-delete-this-line-after-first-start
# --- LOCAL block (uncomment all of it for local use; on the VPS use the domain lines above instead) ---
# WEB_ENABLED=on
# WEB_ADMIN_USER=admin
# WEB_ADMIN_PASSWORD=choose-something-long-here
# WEB_COOKIE_SECURE=off
# WEB_TRUST_PROXY=off
# WEB_PUBLIC_URL=http://localhost:8080
# --- end of LOCAL block ---
# Only for the local override above (plain http://localhost, never on the internet). It sets these itself:
# WEB_LOCAL_PORT=8080
# WEB_COOKIE_SECURE=off
# How long finished files stay downloadable for the person who made them, the per-person allowance, and how many
# things one person can run at once:
# WEB_FILE_TTL_MINUTES=120
# WEB_QUOTA_MB=4096
# WEB_MAX_ACTIVE_JOBS=3
