# ---- Telegram bot credentials ----
# Get this from @BotFather on Telegram
BOT_TOKEN=123456789:AAbecomeYourRealTokenHere

# ---- Required for the LOCAL Bot API server (2GB uploads) ----
# Get these from https://my.telegram.org -> API Development Tools
# (log in with your own phone number, this is free, one-time)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef1234567890abcdef1234567890

# ---- Developers/maintainers ----
# Comma-separated Telegram numeric user IDs that get /update, /potcheck,
# and can also open the owner's admin panel for maintenance.
# Get IDs from @userinfobot.
ADMIN_USER_IDS=111111111,222222222

# ---- The owner (the person this bot is for) ----
# Her Telegram numeric user ID - she gets the admin panel and always
# bypasses access-control/force-join, regardless of what she sets there.
OWNER_USER_ID=333333333

# English letters only. Used for her admin panel command:
# "Candy" -> /candy_admin, "Amy Rose" -> /amy_rose_admin
OWNER_NAME=Candy

# Shows up throughout the bot's messages and progress bar
OWNER_EMOJI=🍬

# ---- Behavior ----
# Hour (UTC, 0-23) the daily yt-dlp/gallery-dl auto-update check runs
AUTO_UPDATE_HOUR_UTC=4

# Max number of downloads processed in parallel across all users
MAX_CONCURRENT_DOWNLOADS=2
